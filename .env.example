# GEMINI_API_KEY: Required for Gemini AI API calls (server-side only).
# Configure via Settings > Secrets in AI Studio or Environment Variables in Vercel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform JS API.
# Restrict to HTTP referrers and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
